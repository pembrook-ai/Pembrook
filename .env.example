# Pembrook — .env.example
#
# Copy this file to .env and fill in your values, OR run:
#   bash scripts/setup.sh
# which generates .env automatically.
#
# NEVER commit .env to version control — it contains private atSign key filenames
# and optional API keys.

# ── Core atSigns ────────────────────────────────────────────────────────────
# The agent atSign: the daemon that runs on your server.
AGENT_AT_SIGN=@myagent

# The owner atSign: your Flutter app / CLI identity.
OWNER_AT_SIGN=@myowner

# ── Service atSigns (SEC-004) ─────────────────────────────────────────────────
# PRODUCTION RECOMMENDATION: assign a separate atSign to each bridge and MCP
# server.  A compromised bridge then cannot impersonate other services or send
# arbitrary commands as a trusted identity.
#
#   WHATSAPP_AT_SIGN=@my_whatsapp_bridge
#   TELEGRAM_AT_SIGN=@my_telegram_bridge
#   DISCORD_AT_SIGN=@my_discord_bridge
#   SLACK_AT_SIGN=@my_slack_bridge
#   MCP_BROWSER_AT_SIGN=@my_mcp_browser
#   MCP_HOME_AT_SIGN=@my_mcp_home
#   MCP_DB_AT_SIGN=@my_mcp_db
#
# ⚠️  DEVELOPMENT CONVENIENCE ONLY — NOT FOR PRODUCTION:
# SERVICES_AT_SIGN lets all bridges and MCP servers share one atSign and one
# key file (max 3 atSigns total).  If any single component is compromised the
# attacker gains the shared private key and can impersonate every other service.
# Do NOT use SERVICES_AT_SIGN in internet-facing or multi-user deployments.
SERVICES_AT_SIGN=@myservices

# ── Keys directory and key file names ──────────────────────────────────────────
# KEYS_DIR: absolute path to the directory containing .atKeys files.
# Default is ~/.atsign/keys — the standard location used by all atSign apps.
# setup.sh expands $HOME and writes the absolute path here automatically.
KEYS_DIR=~/.atsign/keys

# Filenames only — docker-compose mounts KEYS_DIR as /keys in every container.
AGENT_KEY_FILE=@myagent_key.atKeys
SERVICES_KEY_FILE=@myservices_key.atKeys
# Per-service key files (used when per-service atSigns are configured above):
# WHATSAPP_KEY_FILE=@my_whatsapp_bridge_key.atKeys
# TELEGRAM_KEY_FILE=@my_telegram_bridge_key.atKeys
# DISCORD_KEY_FILE=@my_discord_bridge_key.atKeys
# SLACK_KEY_FILE=@my_slack_bridge_key.atKeys
# MCP_BROWSER_KEY_FILE=@my_mcp_browser_key.atKeys
# MCP_HOME_KEY_FILE=@my_mcp_home_key.atKeys
# MCP_DB_KEY_FILE=@my_mcp_db_key.atKeys

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated atSigns that may send commands to the agent.
# Add all service atSigns you configured above.
ALLOWED_USERS=@myowner,@myservices

# ── LLM ──────────────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL defaults to http://host.docker.internal:11434 (macOS/Windows).
# Linux: see GETTING_STARTED.md for docker-compose.override.yml setup
# When using --profile bundled-ollama: OLLAMA_BASE_URL=http://ollama:11434

# ── Timezone ─────────────────────────────────────────────────────────────────
# The agent container always runs in UTC. The app sends the owner's device
# timezone with every request so the LLM correctly interprets wall-clock times.
# No TZ setting is needed here.

# ── Optional external LLM API keys ───────────────────────────────────────────
# Leave blank to use Ollama (local) only.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Optional bridge credentials ───────────────────────────────────────────────
# WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=   ← REQUIRED — bridge will refuse to start without this

# Telegram Bot API
# TELEGRAM_BOT_TOKEN=

# Discord Bot
# DISCORD_TOKEN=

# Slack App
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=

# ── Optional MCP server credentials ───────────────────────────────────────────
# Home Automation MCP server — connects the agent to Home Assistant.
# HA_BASE_URL=http://homeassistant.local:8123
# HA_TOKEN=eyJ...long_lived_access_token...

# Database MCP server — gives the agent access to a SQLite database.
# DB_PATH=/data/pembrook.db

# Browser MCP server — HTTP fetch + HTML extraction (+ optional Playwright for screenshots).
# Set PLAYWRIGHT_WS_URL only if you have a Playwright sidecar running.
# PLAYWRIGHT_WS_URL=http://playwright:3000